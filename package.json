{
    "name": "root",
    "private": true,
    "engines": {
        "node": "^20.19 || ^22.12 || >=24"
    },
    "workspaces": [
        "packages/*",
        "examples/*"
    ],
    "scripts": {
        "prepare": "husky install",
        "pre-commit": "npm run lint && npm run test",
        "prepublishOnly": "npm run build",
        "publish": "lerna publish --no-private",
        "lint": "eslint packages/",
        "build": "lerna run build",
        "build:watch": "lerna run build:watch",
        "test": "lerna run test",
        "start": "npm run build && lerna run start --scope=storybook-app"
    },
    "devDependencies": {
        "@eslint/compat": "^2.0.5",
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^10.0.1",
        "@typescript-eslint/eslint-plugin": "^8.59.0",
        "@typescript-eslint/parser": "^8.59.0",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^8.10.2",
        "eslint-plugin-github": "^4.10.2",
        "eslint-plugin-jest": "^29.15.2",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-sonarjs": "^4.0.3",
        "husky": "^8.0.3",
        "lerna": "^9.0.7",
        "nx": "^22.6.5",
        "prettier": "^3.8.3"
    },
    "author": {
        "name": "Joël Piazzalunga-Lerat"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jpiazzal/ts2doc.git"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/jpiazzal/ts2doc/issues"
    },
    "homepage": "https://github.com/jpiazzal/ts2doc#readme"
}
