{
    "name": "@ts2doc/components",
    "version": "0.4.0",
    "description": "Ts2doc components that display documentation from ts2doc json. It uses storybook components.",
    "keywords": [
        "typescript",
        "documentation",
        "components",
        "storybook",
        "ts2doc"
    ],
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist/**/*"
    ],
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "rollup -c",
        "build:watch": "rollup -c -w"
    },
    "peerDependencies": {
        "@ts2doc/json": "^0.3.0",
        "react": "^16.8.0 || ^17.0.0 || ^18.0.0",
        "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0",
        "storybook": "^10.0.0"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/react": "^18.3.28",
        "@types/react-dom": "^18.3.7",
        "rimraf": "^3.0.2",
        "rollup": "^4.60.2",
        "rollup-plugin-dts": "^6.4.1",
        "rollup-plugin-peer-deps-external": "^2.2.4",
        "typescript": "^5.9.3"
    },
    "author": {
        "name": "Joël Piazzalunga-Lerat"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jpiazzal/ts2doc.git"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/jpiazzal/ts2doc/issues"
    },
    "homepage": "https://github.com/jpiazzal/ts2doc#readme"
}
